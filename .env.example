# Settings for `docker compose` (copy to .env). Never commit the real .env file.

# Database
POSTGRES_USER=autobaz
POSTGRES_DB=autobaz
# REQUIRED. A long random password.
POSTGRES_PASSWORD=change-me

# REQUIRED. Secret for signing login tokens: use a long random string, for example `openssl rand -hex 48`.
# Changing it logs everybody out.
JWT_SECRET=change-me

# Port on which the website is published on this machine
WEB_PORT=8080

# Public site URL baked into the frontend at build time (login and account links). No trailing slash.
VITE_PUBLIC_APP_URL=https://autobaz.az

# Only if the API is used from another origin than the website
# CORS_ORIGIN=https://autobaz.az

# Public address of the website, used to build the payment return links.
# REQUIRED on a server. Example: https://autobaz.az
PUBLIC_WEB_URL=http://localhost:8080

# REQUIRED on a server. Secret that signs the stub payment provider's callbacks.
# A long random string, for example `openssl rand -hex 32`.
PAYMENT_MOCK_SECRET=change-me

# Number of reverse proxies in front of the backend. The website container (nginx) counts as one;
# add one more if Caddy / a load balancer sits in front of it (then use 2).
TRUSTED_PROXY_HOPS=1

# Set to "off" to switch off the background promotions clock (only when running several backend copies).
# PROMOTIONS_SCHEDULER=on

# Listing description AI and catalog smart search. Both must be set or the UI hides AI.
# The key stays on the server. Never put it in the frontend.
# AI_ENABLED=false
# ANTHROPIC_API_KEY=
# AI_MODEL_DESCRIPTION=claude-sonnet-5-5
# AI_MODEL_SEARCH=claude-haiku-5-5
# AI_TIMEOUT_MS=20000
# AI_RATE_LIMIT_DESCRIPTION=20
# AI_RATE_LIMIT_DESCRIPTION_WINDOW_SEC=3600
# AI_RATE_LIMIT_SEARCH=30
# AI_RATE_LIMIT_SEARCH_WINDOW_SEC=3600
# AI_SEARCH_CACHE_TTL_MS=60000
# Site assistant chat (searches only our own catalogue)
# AI_MODEL_CHAT=claude-haiku-5-5
# AI_CHAT_EFFORT=low
# AI_CHAT_TIMEOUT_MS=45000
# AI_RATE_LIMIT_CHAT=40
# AI_RATE_LIMIT_CHAT_WINDOW_SEC=3600
# Photos in the chat (JPEG/PNG/WebP, max 4 MB, checked byte by byte, never stored)
# AI_RATE_LIMIT_CHAT_IMAGE=15
# AI_RATE_LIMIT_CHAT_IMAGE_WINDOW_SEC=3600
# Text chat runs on the cheap model; photos on the vision model.
# AI_MODEL_CHAT_VISION=claude-sonnet-5-5
# Daily spend protection (day = Baku calendar day). A text message is 1 unit, a photo AI_CHAT_IMAGE_WEIGHT.
# AI_DAILY_LIMIT_PER_IP=60
# AI_CHAT_IMAGE_WEIGHT=5
# AI_DAILY_LIMIT_GLOBAL=3000
# AI pauses itself for the rest of the day once this estimated spend is reached.
# AI_DAILY_BUDGET_USD=5
# AI_CHAT_CACHE_TTL_SEC=600
# AI_CATALOG_CACHE_TTL_SEC=120
