# Settings for `docker compose` (copy to .env). Never commit the real .env file.

# Database
POSTGRES_USER=autobaz
POSTGRES_DB=autobaz
# REQUIRED. A long random password.
POSTGRES_PASSWORD=change-me

# REQUIRED. Secret for signing login tokens: use a long random string, for example `openssl rand -hex 48`.
# Changing it logs everybody out.
JWT_SECRET=change-me

# Port on which the website is published on this machine
WEB_PORT=8080

# Only if the API is used from another origin than the website
# CORS_ORIGIN=https://your-domain.example

# Listing description AI and catalog smart search. Both must be set or the UI hides AI.
# The key stays on the server. Never put it in the frontend.
# AI_ENABLED=false
# ANTHROPIC_API_KEY=
# AI_MODEL_DESCRIPTION=claude-sonnet-5-5
# AI_MODEL_SEARCH=claude-haiku-5-5
# AI_TIMEOUT_MS=20000
# AI_RATE_LIMIT_DESCRIPTION=20
# AI_RATE_LIMIT_DESCRIPTION_WINDOW_SEC=3600
# AI_RATE_LIMIT_SEARCH=30
# AI_RATE_LIMIT_SEARCH_WINDOW_SEC=3600
# AI_SEARCH_CACHE_TTL_MS=60000
# Site assistant chat (searches only our own catalogue)
# AI_MODEL_CHAT=claude-opus-5-5
# AI_CHAT_EFFORT=low
# AI_CHAT_TIMEOUT_MS=45000
# AI_RATE_LIMIT_CHAT=40
# AI_RATE_LIMIT_CHAT_WINDOW_SEC=3600
# Photos in the chat (JPEG/PNG/WebP, max 4 MB, checked byte by byte, never stored)
# AI_RATE_LIMIT_CHAT_IMAGE=15
# AI_RATE_LIMIT_CHAT_IMAGE_WINDOW_SEC=3600
