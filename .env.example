# Settings for `docker compose` (copy to .env). Never commit the real .env file.

# Database
POSTGRES_USER=autobaz
POSTGRES_DB=autobaz
# REQUIRED. A long random password.
POSTGRES_PASSWORD=change-me

# REQUIRED. Secret for signing login tokens: use a long random string, for example `openssl rand -hex 48`.
# Changing it logs everybody out.
JWT_SECRET=change-me

# Port on which the website is published on this machine
WEB_PORT=8080

# Only if the API is used from another origin than the website
# CORS_ORIGIN=https://your-domain.example
