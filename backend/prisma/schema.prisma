generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  PRIVATE_SELLER
  DEALER
  PARTS_DEALER
  SERVICE
  SPECIALIST
  ADMIN
}

enum SellerType {
  PRIVATE
  DEALER
  PARTS_DEALER
}

enum ListingPurpose {
  SALE
  RENT
}

enum RentalStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

enum InquiryStatus {
  NEW
  READ
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  /// Hidden by a moderator; the owner cannot publish it again
  BLOCKED
}

enum ReportReason {
  SPAM
  SCAM
  WRONG_INFO
  PROHIBITED
  ALREADY_SOLD
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

/// Paid placement products, from cheapest to dearest. Each tier includes the one below it.
enum PromotionTier {
  /// Moves the listing back to the top of its catalogue, a fixed number of times.
  BUMP
  /// A slot in the VIP block plus one automatic bump a day, for a number of days.
  VIP
  /// Everything VIP has, plus the home page and three bumps a day.
  PREMIUM
}

enum PromotionTarget {
  LISTING
  SPECIALIST
  SERVICE_CENTER
}

enum PromotionOrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole
  /// Bumped when the password changes; tokens carrying an older value are rejected.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  seller          Seller?
  bids            Bid[]
  serviceCenter   ServiceCenter?
  specialist      Specialist?
  favorites       Favorite[]
  inquiries       Inquiry[]
  reports         Report[]
  rentalBookings  RentalBooking[]
  reviews         Review[]
  appointments    Appointment[]
  promotionOrders PromotionOrder[]
}

model Seller {
  id           String     @id @default(cuid())
  userId       String     @unique
  type         SellerType
  name         String
  city         String
  phone        String?
  /// When false the phone number is hidden from public queries
  showPhone    Boolean    @default(true)
  /// Contact email for the seller's own use (never shown publicly)
  contactEmail String?
  /// Average of the reviews (0 while there are none), kept in sync by the reviews service
  rating       Float      @default(0)
  reviewsCount Int        @default(0)
  verified     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings Listing[]
  reviews  Review[]
}

model Listing {
  id            String         @id @default(cuid())
  title         String
  description   String
  price         Decimal        @db.Decimal(12, 2)
  status        ListingStatus
  /// Why a moderator blocked the listing (shown to the owner)
  blockedReason String?
  /// SALE listings are sold, RENT listings are rented out per day (price = price per day)
  purpose       ListingPurpose @default(SALE)
  sellerId      String
  /// Highest active promotion: 0 none, 1 VIP, 2 PREMIUM. Catalogues sort by it first.
  promotionRank Int            @default(0)
  /// When the current VIP/PREMIUM placement runs out; null when there is none.
  promotedUntil DateTime?
  /// Moves to "now" on every bump. Catalogues order by this instead of createdAt.
  bumpedAt      DateTime       @default(now())
  /// How often the detail page was opened and the contacts revealed.
  viewsCount    Int            @default(0)
  contactsCount Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  seller          Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  vehicles        Vehicle[]
  parts           Part[]
  services        Service[]
  images          Image[]
  auctions        Auction[]
  inquiries       Inquiry[]
  reports         Report[]
  rentalTerms     RentalTerms?
  rentalBookings  RentalBooking[]
  rentalBlocks    RentalBlock[]
  promotions      Promotion[]
  promotionOrders PromotionOrder[]

  @@index([status, promotionRank, bumpedAt])
}

model Vehicle {
  id                String   @id @default(cuid())
  listingId         String
  brand             String
  model             String
  generation        String?  @default("")
  version           String?
  year              Int
  mileage           Int
  fuel              String
  transmission      String
  displacement      String?
  horsepower        String?
  engineVolume      Float
  power             Int
  drive             String?
  condition         String   @default("used")
  color             String?
  vehicleType       String   @default("car")
  /// Body style chosen in the wizard: sedan, suv, coupe ...
  bodyType          String?
  price             Decimal? @db.Decimal(12, 2)
  currency          String   @default("AZN")
  location          String?
  description       String?
  imageUrls         String[]
  isHot             Boolean  @default(false)
  isCreditAvailable Boolean  @default(false)
  isBarterAvailable Boolean  @default(false)
  hasDamage         Boolean  @default(false)
  isRepainted       Boolean  @default(false)
  wasInAccident     Boolean  @default(false)
  ownersCount       Int      @default(1)
  seatsCount        Int?
  marketRegion      String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Part {
  id            String   @id @default(cuid())
  listingId     String
  name          String
  category      String
  brand         String
  model         String
  condition     String
  oemCode       String?
  stock         Int      @default(0)
  description   String?
  price         Decimal? @db.Decimal(12, 2)
  currency      String   @default("AZN")
  imageUrl      String?
  compatibility String[]
  location      String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Service {
  id              String   @id @default(cuid())
  listingId       String
  name            String
  categories      String[]
  supportedBrands String[]
  city            String
  rating          Float

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model ServiceCenter {
  id              String    @id @default(cuid())
  userId          String    @unique
  name            String
  slug            String?   @unique
  description     String?
  legalName       String?
  type            String?
  city            String
  address         String?
  phone           String?
  whatsapp        String?
  website         String?
  logoUrl         String?
  coverImage      String?
  gallery         String[]
  categories      String[]
  supportedBrands String[]
  rating          Float     @default(0)
  reviewsCount    Int       @default(0)
  verified        Boolean   @default(false)
  isActive        Boolean   @default(true)
  schedule        Json?
  contacts        Json?
  promotionRank   Int       @default(0)
  promotedUntil   DateTime?
  bumpedAt        DateTime  @default(now())
  viewsCount      Int       @default(0)
  contactsCount   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  services        ServiceCenterService[]
  reviews         Review[]
  appointments    Appointment[]
  promotions      Promotion[]
  promotionOrders PromotionOrder[]

  @@index([promotionRank, bumpedAt])
}

model ServiceCenterService {
  id               String   @id @default(cuid())
  serviceCenterId  String
  code             String
  title            String
  category         String
  priceFrom        Decimal? @db.Decimal(10, 2)
  priceTo          Decimal? @db.Decimal(10, 2)
  currency         String   @default("AZN")
  durationMin      Int?
  applicableBrands String[]
  popular          Boolean  @default(false)

  serviceCenter ServiceCenter @relation(fields: [serviceCenterId], references: [id], onDelete: Cascade)
}

model Specialist {
  id              String    @id @default(cuid())
  userId          String    @unique
  name            String
  slug            String    @unique
  bio             String?
  city            String
  phone           String?
  whatsapp        String?
  avatarUrl       String?
  coverImage      String?
  skills          String[]
  specializations String[]
  experience      Int       @default(0)
  rating          Float     @default(0)
  reviewsCount    Int       @default(0)
  hourlyRate      Decimal?  @db.Decimal(10, 2)
  priceFrom       Decimal?  @db.Decimal(10, 2)
  mobileService   Boolean   @default(false)
  verified        Boolean   @default(false)
  available       Boolean   @default(true)
  portfolio       String[]
  promotionRank   Int       @default(0)
  promotedUntil   DateTime?
  bumpedAt        DateTime  @default(now())
  viewsCount      Int       @default(0)
  contactsCount   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  supportedVehicles SpecialistVehicle[]
  reviews           Review[]
  appointments      Appointment[]
  promotions        Promotion[]
  promotionOrders   PromotionOrder[]

  @@index([promotionRank, bumpedAt])
}

model SpecialistVehicle {
  id           String @id @default(cuid())
  specialistId String
  brand        String
  model        String
  yearFrom     Int?
  yearTo       Int?

  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
}

/// A 1-5 star review of a seller, specialist or service center. Exactly one target is set
/// (enforced by a CHECK constraint) and every author can review a target once.
model Review {
  id              String   @id @default(cuid())
  authorId        String
  sellerId        String?
  specialistId    String?
  serviceCenterId String?
  rating          Int
  comment         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  seller        Seller?        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  specialist    Specialist?    @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  serviceCenter ServiceCenter? @relation(fields: [serviceCenterId], references: [id], onDelete: Cascade)

  @@unique([authorId, sellerId])
  @@unique([authorId, specialistId])
  @@unique([authorId, serviceCenterId])
  @@index([sellerId, createdAt])
  @@index([specialistId, createdAt])
  @@index([serviceCenterId, createdAt])
}

/// A customer's request for a visit to a specialist or a service center. Exactly one target is
/// set (CHECK constraint); the owner of the profile confirms or declines it.
model Appointment {
  id              String            @id @default(cuid())
  customerId      String
  specialistId    String?
  serviceCenterId String?
  /// Requested day (no time zone) and an optional preferred time like "14:30"
  date            DateTime          @db.Date
  time            String?
  vehicle         String?
  message         String?
  phone           String
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  decidedAt       DateTime?

  customer      User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  specialist    Specialist?    @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  serviceCenter ServiceCenter? @relation(fields: [serviceCenterId], references: [id], onDelete: Cascade)

  @@index([specialistId, status])
  @@index([serviceCenterId, status])
  @@index([customerId])
}

model Image {
  id        String @id @default(cuid())
  listingId String
  url       String
  position  Int

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Auction {
  id           String   @id @default(cuid())
  listingId    String
  startPrice   Decimal  @db.Decimal(12, 2)
  currentPrice Decimal  @db.Decimal(12, 2)
  startTime    DateTime
  endTime      DateTime
  status       String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bids    Bid[]
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  /// 'vehicle' | 'part'
  type      String
  /// Vehicle.id or Part.id depending on type
  itemId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, itemId])
  @@index([userId])
}

model Inquiry {
  id         String        @id @default(cuid())
  listingId  String
  fromUserId String
  message    String
  phone      String?
  status     InquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fromUser User    @relation(fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([fromUserId])
}

model Report {
  id         String       @id @default(cuid())
  listingId  String
  reporterId String
  reason     ReportReason
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([status, createdAt])
  @@index([reporterId])
}

model RentalTerms {
  listingId    String   @id
  deposit      Decimal? @db.Decimal(12, 2)
  minDays      Int      @default(1)
  maxDays      Int?
  /// Included kilometres per day; null means unlimited
  kmPerDay     Int?
  minDriverAge Int?
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model RentalBooking {
  id          String       @id @default(cuid())
  listingId   String
  renterId    String
  /// First and last rental day, inclusive (dates without time)
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  days        Int
  pricePerDay Decimal      @db.Decimal(12, 2)
  totalPrice  Decimal      @db.Decimal(12, 2)
  deposit     Decimal?     @db.Decimal(12, 2)
  currency    String       @default("AZN")
  message     String?
  phone       String?
  status      RentalStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  decidedAt   DateTime?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  renter  User    @relation(fields: [renterId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([renterId])
}

/// Days on which the owner cannot rent the car out (it is used elsewhere, in service ...)
model RentalBlock {
  id        String   @id @default(cuid())
  listingId String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

/// A paid (or administrator-granted) placement of one listing or professional profile.
/// Exactly one target is set, enforced by a CHECK constraint.
model Promotion {
  id              String          @id @default(cuid())
  targetType      PromotionTarget
  listingId       String?
  specialistId    String?
  serviceCenterId String?
  tier            PromotionTier
  packageCode     String
  /// What was paid for this placement, in qapik. Zero for administrator grants.
  amount          Int             @default(0)
  currency        String          @default("AZN")
  startsAt        DateTime        @default(now())
  endsAt          DateTime
  /// Automatic bumps: how many the package carries, how many were spent, when the next is due.
  bumpsTotal      Int             @default(0)
  bumpsUsed       Int             @default(0)
  nextBumpAt      DateTime?
  lastBumpAt      DateTime?
  /// The target's counters the moment the placement started, so the buyer can see
  /// how many views and contacts the money actually brought.
  viewsAtStart    Int             @default(0)
  contactsAtStart Int             @default(0)
  active          Boolean         @default(true)
  /// Why it stopped: "expired", "spent", "upgraded", "revoked", "target_blocked".
  endedReason     String?
  endedAt         DateTime?
  /// Administrator who granted it by hand, if nobody paid.
  grantedBy       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  listing       Listing?        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  specialist    Specialist?     @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  serviceCenter ServiceCenter?  @relation(fields: [serviceCenterId], references: [id], onDelete: Cascade)
  order         PromotionOrder?

  @@index([active, endsAt])
  @@index([active, nextBumpAt])
  @@index([active, tier])
  @@index([listingId])
  @@index([specialistId])
  @@index([serviceCenterId])
}

/// A checkout for a promotion. Visitors do not have to be signed in, so the order is
/// addressed by an unguessable token rather than by its id.
model PromotionOrder {
  id                  String               @id @default(cuid())
  /// Secret handle of the order; also the reference sent to the payment provider.
  token               String               @unique
  targetType          PromotionTarget
  listingId           String?
  specialistId        String?
  serviceCenterId     String?
  tier                PromotionTier
  packageCode         String
  /// Price list amount, the upgrade credit taken off it, and what is actually charged
  /// (all in qapik). amount = listAmount - creditAmount.
  listAmount          Int
  creditAmount        Int                  @default(0)
  amount              Int
  currency            String               @default("AZN")
  /// Placement whose unused days funded creditAmount; it is retired when this order is paid.
  creditedPromotionId String?
  status              PromotionOrderStatus @default(PENDING)
  /// Where to send the receipt. Optional, and stored exactly as the buyer typed it.
  contactEmail        String?
  contactPhone        String?
  /// Set when a signed-in user checked out, so it shows up in their dashboard.
  userId              String?
  /// An unpaid order stops being payable after this moment.
  expiresAt           DateTime
  paidAt              DateTime?
  /// The placement this order bought; null until the provider confirms the payment.
  promotionId         String?              @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing       Listing?       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  specialist    Specialist?    @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  serviceCenter ServiceCenter? @relation(fields: [serviceCenterId], references: [id], onDelete: Cascade)
  promotion     Promotion?     @relation(fields: [promotionId], references: [id])
  payments      Payment[]

  @@index([status, expiresAt])
  @@index([userId, createdAt])
}

/// One charge attempt reported by the payment provider, kept for reconciliation and
/// disputes. The provider's own id makes a repeated callback a no-op.
model Payment {
  id                String   @id @default(cuid())
  orderId           String
  provider          String
  providerPaymentId String
  status            String
  amount            Int
  currency          String   @default("AZN")
  /// Raw callback payload, for support.
  payload           Json?
  createdAt         DateTime @default(now())

  order PromotionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([orderId])
}
