generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  PRIVATE_SELLER
  DEALER
  PARTS_DEALER
  SERVICE
  SPECIALIST
  ADMIN
}

enum SellerType {
  PRIVATE
  DEALER
  PARTS_DEALER
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  role          UserRole
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  seller        Seller?
  bids          Bid[]
  serviceCenter ServiceCenter?
  specialist    Specialist?
}

model Seller {
  id        String     @id @default(cuid())
  userId    String     @unique
  type      SellerType
  name      String
  city      String
  rating    Float
  verified  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings Listing[]
}

model Listing {
  id          String        @id @default(cuid())
  title       String
  description String
  price       Decimal       @db.Decimal(12, 2)
  status      ListingStatus
  sellerId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  seller   Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]
  parts    Part[]
  services Service[]
  images   Image[]
  auctions Auction[]
}

model Vehicle {
  id                  String   @id @default(cuid())
  listingId           String
  brand               String
  model               String
  generation          String?  @default("")
  version             String?
  year                Int
  mileage             Int
  fuel                String
  transmission        String
  displacement        String?
  horsepower          String?
  engineVolume        Float
  power               Int
  drive               String?
  condition           String   @default("used")
  color               String?
  vehicleType         String   @default("car")
  price               Decimal? @db.Decimal(12, 2)
  currency            String   @default("AZN")
  location            String?
  description         String?
  imageUrls           String[]
  isHot               Boolean  @default(false)
  isCreditAvailable   Boolean  @default(false)
  isBarterAvailable   Boolean  @default(false)
  hasDamage           Boolean  @default(false)
  isRepainted         Boolean  @default(false)
  wasInAccident       Boolean  @default(false)
  ownersCount         Int      @default(1)
  seatsCount          Int?
  marketRegion        String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Part {
  id             String   @id @default(cuid())
  listingId      String
  name           String
  category       String
  brand          String
  model          String
  condition      String
  oemCode        String?
  stock          Int      @default(0)
  description    String?
  price          Decimal? @db.Decimal(12, 2)
  currency       String   @default("AZN")
  imageUrl       String?
  compatibility  String[]
  location       String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Service {
  id              String   @id @default(cuid())
  listingId       String
  name            String
  categories      String[]
  supportedBrands String[]
  city            String
  rating          Float

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model ServiceCenter {
  id               String   @id @default(cuid())
  userId           String   @unique
  name             String
  slug             String?  @unique
  description      String?
  legalName        String?
  type             String?
  city             String
  address          String?
  phone            String?
  whatsapp         String?
  website          String?
  logoUrl          String?
  coverImage       String?
  gallery          String[]
  categories       String[]
  supportedBrands  String[]
  rating           Float    @default(0)
  reviewsCount     Int      @default(0)
  verified         Boolean  @default(false)
  isActive         Boolean  @default(true)
  schedule         Json?
  contacts         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  services ServiceCenterService[]
}

model ServiceCenterService {
  id               String   @id @default(cuid())
  serviceCenterId  String
  code             String
  title            String
  category         String
  priceFrom        Decimal? @db.Decimal(10, 2)
  priceTo          Decimal? @db.Decimal(10, 2)
  currency         String   @default("AZN")
  durationMin      Int?
  applicableBrands String[]
  popular          Boolean  @default(false)

  serviceCenter ServiceCenter @relation(fields: [serviceCenterId], references: [id], onDelete: Cascade)
}

model Specialist {
  id                String   @id @default(cuid())
  userId            String   @unique
  name              String
  slug              String   @unique
  bio               String?
  city              String
  phone             String?
  whatsapp          String?
  avatarUrl         String?
  coverImage        String?
  skills            String[]
  specializations   String[]
  experience        Int      @default(0)
  rating            Float    @default(0)
  reviewsCount      Int      @default(0)
  hourlyRate        Decimal? @db.Decimal(10, 2)
  priceFrom         Decimal? @db.Decimal(10, 2)
  mobileService     Boolean  @default(false)
  verified          Boolean  @default(false)
  available         Boolean  @default(true)
  portfolio         String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  supportedVehicles   SpecialistVehicle[]
}

model SpecialistVehicle {
  id             String  @id @default(cuid())
  specialistId   String
  brand          String
  model          String
  yearFrom       Int?
  yearTo         Int?

  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
}

model Image {
  id        String @id @default(cuid())
  listingId String
  url       String
  position  Int

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Auction {
  id           String   @id @default(cuid())
  listingId    String
  startPrice   Decimal  @db.Decimal(12, 2)
  currentPrice Decimal  @db.Decimal(12, 2)
  startTime    DateTime
  endTime      DateTime
  status       String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bids    Bid[]
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
