generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  PRIVATE_SELLER
  DEALER
  PARTS_DEALER
  SERVICE
  SPECIALIST
  ADMIN
}

enum SellerType {
  PRIVATE
  DEALER
  PARTS_DEALER
}

enum ListingPurpose {
  SALE
  RENT
}

enum RentalStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

enum InquiryStatus {
  NEW
  READ
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  /// Hidden by a moderator; the owner cannot publish it again
  BLOCKED
}

enum ReportReason {
  SPAM
  SCAM
  WRONG_INFO
  PROHIBITED
  ALREADY_SOLD
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole
  /// Bumped when the password changes; tokens carrying an older value are rejected.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  seller         Seller?
  bids           Bid[]
  serviceCenter  ServiceCenter?
  specialist     Specialist?
  favorites      Favorite[]
  inquiries      Inquiry[]
  reports        Report[]
  rentalBookings RentalBooking[]
  reviews        Review[]
  appointments   Appointment[]
}

model Seller {
  id           String     @id @default(cuid())
  userId       String     @unique
  type         SellerType
  name         String
  city         String
  phone        String?
  /// When false the phone number is hidden from public queries
  showPhone    Boolean    @default(true)
  /// Contact email for the seller's own use (never shown publicly)
  contactEmail String?
  /// Average of the reviews (0 while there are none), kept in sync by the reviews service
  rating       Float      @default(0)
  reviewsCount Int        @default(0)
  verified     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings Listing[]
  reviews  Review[]
}

model Listing {
  id            String         @id @default(cuid())
  title         String
  description   String
  price         Decimal        @db.Decimal(12, 2)
  status        ListingStatus
  /// Why a moderator blocked the listing (shown to the owner)
  blockedReason String?
  /// SALE listings are sold, RENT listings are rented out per day (price = price per day)
  purpose       ListingPurpose @default(SALE)
  sellerId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  seller         Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  vehicles       Vehicle[]
  parts          Part[]
  services       Service[]
  images         Image[]
  auctions       Auction[]
  inquiries      Inquiry[]
  reports        Report[]
  rentalTerms    RentalTerms?
  rentalBookings RentalBooking[]
  rentalBlocks   RentalBlock[]
}

model Vehicle {
  id                String   @id @default(cuid())
  listingId         String
  brand             String
  model             String
  generation        String?  @default("")
  version           String?
  year              Int
  mileage           Int
  fuel              String
  transmission      String
  displacement      String?
  horsepower        String?
  engineVolume      Float
  power             Int
  drive             String?
  condition         String   @default("used")
  color             String?
  vehicleType       String   @default("car")
  /// Body style chosen in the wizard: sedan, suv, coupe ...
  bodyType          String?
  price             Decimal? @db.Decimal(12, 2)
  currency          String   @default("AZN")
  location          String?
  description       String?
  imageUrls         String[]
  isHot             Boolean  @default(false)
  isCreditAvailable Boolean  @default(false)
  isBarterAvailable Boolean  @default(false)
  hasDamage         Boolean  @default(false)
  isRepainted       Boolean  @default(false)
  wasInAccident     Boolean  @default(false)
  ownersCount       Int      @default(1)
  seatsCount        Int?
  marketRegion      String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Part {
  id            String   @id @default(cuid())
  listingId     String
  name          String
  category      String
  brand         String
  model         String
  condition     String
  oemCode       String?
  stock         Int      @default(0)
  description   String?
  price         Decimal? @db.Decimal(12, 2)
  currency      String   @default("AZN")
  imageUrl      String?
  compatibility String[]
  location      String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Service {
  id              String   @id @default(cuid())
  listingId       String
  name            String
  categories      String[]
  supportedBrands String[]
  city            String
  rating          Float

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model ServiceCenter {
  id              String   @id @default(cuid())
  userId          String   @unique
  name            String
  slug            String?  @unique
  description     String?
  legalName       String?
  type            String?
  city            String
  address         String?
  phone           String?
  whatsapp        String?
  website         String?
  logoUrl         String?
  coverImage      String?
  gallery         String[]
  categories      String[]
  supportedBrands String[]
  rating          Float    @default(0)
  reviewsCount    Int      @default(0)
  verified        Boolean  @default(false)
  isActive        Boolean  @default(true)
  schedule        Json?
  contacts        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     ServiceCenterService[]
  reviews      Review[]
  appointments Appointment[]
}

model ServiceCenterService {
  id               String   @id @default(cuid())
  serviceCenterId  String
  code             String
  title            String
  category         String
  priceFrom        Decimal? @db.Decimal(10, 2)
  priceTo          Decimal? @db.Decimal(10, 2)
  currency         String   @default("AZN")
  durationMin      Int?
  applicableBrands String[]
  popular          Boolean  @default(false)

  serviceCenter ServiceCenter @relation(fields: [serviceCenterId], references: [id], onDelete: Cascade)
}

model Specialist {
  id              String   @id @default(cuid())
  userId          String   @unique
  name            String
  slug            String   @unique
  bio             String?
  city            String
  phone           String?
  whatsapp        String?
  avatarUrl       String?
  coverImage      String?
  skills          String[]
  specializations String[]
  experience      Int      @default(0)
  rating          Float    @default(0)
  reviewsCount    Int      @default(0)
  hourlyRate      Decimal? @db.Decimal(10, 2)
  priceFrom       Decimal? @db.Decimal(10, 2)
  mobileService   Boolean  @default(false)
  verified        Boolean  @default(false)
  available       Boolean  @default(true)
  portfolio       String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  supportedVehicles SpecialistVehicle[]
  reviews           Review[]
  appointments      Appointment[]
}

model SpecialistVehicle {
  id           String @id @default(cuid())
  specialistId String
  brand        String
  model        String
  yearFrom     Int?
  yearTo       Int?

  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
}

/// A 1-5 star review of a seller, specialist or service center. Exactly one target is set
/// (enforced by a CHECK constraint) and every author can review a target once.
model Review {
  id              String   @id @default(cuid())
  authorId        String
  sellerId        String?
  specialistId    String?
  serviceCenterId String?
  rating          Int
  comment         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  seller        Seller?        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  specialist    Specialist?    @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  serviceCenter ServiceCenter? @relation(fields: [serviceCenterId], references: [id], onDelete: Cascade)

  @@unique([authorId, sellerId])
  @@unique([authorId, specialistId])
  @@unique([authorId, serviceCenterId])
  @@index([sellerId, createdAt])
  @@index([specialistId, createdAt])
  @@index([serviceCenterId, createdAt])
}

/// A customer's request for a visit to a specialist or a service center. Exactly one target is
/// set (CHECK constraint); the owner of the profile confirms or declines it.
model Appointment {
  id              String            @id @default(cuid())
  customerId      String
  specialistId    String?
  serviceCenterId String?
  /// Requested day (no time zone) and an optional preferred time like "14:30"
  date            DateTime          @db.Date
  time            String?
  vehicle         String?
  message         String?
  phone           String
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  decidedAt       DateTime?

  customer      User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  specialist    Specialist?    @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  serviceCenter ServiceCenter? @relation(fields: [serviceCenterId], references: [id], onDelete: Cascade)

  @@index([specialistId, status])
  @@index([serviceCenterId, status])
  @@index([customerId])
}

model Image {
  id        String @id @default(cuid())
  listingId String
  url       String
  position  Int

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Auction {
  id           String   @id @default(cuid())
  listingId    String
  startPrice   Decimal  @db.Decimal(12, 2)
  currentPrice Decimal  @db.Decimal(12, 2)
  startTime    DateTime
  endTime      DateTime
  status       String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bids    Bid[]
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  /// 'vehicle' | 'part'
  type      String
  /// Vehicle.id or Part.id depending on type
  itemId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, itemId])
  @@index([userId])
}

model Inquiry {
  id         String        @id @default(cuid())
  listingId  String
  fromUserId String
  message    String
  phone      String?
  status     InquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fromUser User    @relation(fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([fromUserId])
}

model Report {
  id         String       @id @default(cuid())
  listingId  String
  reporterId String
  reason     ReportReason
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([status, createdAt])
  @@index([reporterId])
}

model RentalTerms {
  listingId    String   @id
  deposit      Decimal? @db.Decimal(12, 2)
  minDays      Int      @default(1)
  maxDays      Int?
  /// Included kilometres per day; null means unlimited
  kmPerDay     Int?
  minDriverAge Int?
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model RentalBooking {
  id          String       @id @default(cuid())
  listingId   String
  renterId    String
  /// First and last rental day, inclusive (dates without time)
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  days        Int
  pricePerDay Decimal      @db.Decimal(12, 2)
  totalPrice  Decimal      @db.Decimal(12, 2)
  deposit     Decimal?     @db.Decimal(12, 2)
  currency    String       @default("AZN")
  message     String?
  phone       String?
  status      RentalStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  decidedAt   DateTime?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  renter  User    @relation(fields: [renterId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([renterId])
}

/// Days on which the owner cannot rent the car out (it is used elsewhere, in service ...)
model RentalBlock {
  id        String   @id @default(cuid())
  listingId String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}
