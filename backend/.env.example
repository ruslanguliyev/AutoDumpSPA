# Copy to backend/.env for local development (npm run start:dev).
# With Docker Compose these values come from the root .env instead.

# HTTP port of the API
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autobaz

# Secret used to sign login tokens. REQUIRED. Use a long random string (e.g. `openssl rand -hex 48`).
JWT_SECRET=change-me

# Browser origins allowed to call the API, comma separated (default: http://localhost:5173)
# CORS_ORIGIN=http://localhost:5173

# Set to "production" on a server: hides the GraphQL schema (introspection) and stack traces.
# NODE_ENV=production

# --- Paid placement (promotions) ---

# Public address of the website, used to build the payment return links.
# REQUIRED on a server (e.g. https://autobaz.az). If unset, the first CORS_ORIGIN is used,
# then http://localhost:5173.
# PUBLIC_WEB_URL=http://localhost:5173

# Secret that signs the payment callbacks of the stub payment provider.
# REQUIRED on a server: without it the well-known default `dev-mock-secret` is used.
# Replaced by the provider's own key once a real payment provider is connected.
# PAYMENT_MOCK_SECRET=dev-mock-secret

# Set to "off" to disable the background clock that ends placements and spends bumps.
# Leave unset on a single server. With several backend copies, run it on one only.
# PROMOTIONS_SCHEDULER=off

# Number of reverse proxies in front of the API (default: 1). Needed so that the visitor's
# real IP is counted instead of the proxy's.
# TRUSTED_PROXY_HOPS=1
