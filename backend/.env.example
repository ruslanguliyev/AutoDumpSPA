# Copy to backend/.env for local development (npm run start:dev).
# With Docker Compose these values come from the root .env instead.

# HTTP port of the API
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/avtobaz

# Secret used to sign login tokens. REQUIRED. Use a long random string (e.g. `openssl rand -hex 48`).
JWT_SECRET=change-me

# Browser origins allowed to call the API, comma separated (default: http://localhost:5173)
# CORS_ORIGIN=http://localhost:5173

# Set to "production" on a server: hides the GraphQL schema (introspection) and stack traces.
# NODE_ENV=production
