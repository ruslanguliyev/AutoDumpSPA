# Backend GraphQL endpoint
VITE_API_URL=http://localhost:4000/graphql

# Public site URL for login and account links. No trailing slash. Defaults to https://autobaz.az.
VITE_PUBLIC_APP_URL=https://autobaz.az

# Mock switches (all default off — real backend). Memberships have no API yet
# and stay hidden unless this is exactly true.
# VITE_USE_PARTS_MOCKS=false
# VITE_USE_SERVICES_MOCKS=false
# VITE_USE_SPECIALISTS_MOCKS=false
# VITE_USE_MEMBERSHIPS_MOCKS=true

VITE_CAR_API_KEY=
VITE_CARIMAGES_API_KEY=
